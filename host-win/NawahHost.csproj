<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIPalmHost</AssemblyName>
    <RootNamespace>NawahHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.9.11</Version>
    <AssemblyVersion>0.9.11.0</AssemblyVersion>
    <FileVersion>0.9.11.0</FileVersion>
    <Company>AI Palm</Company>
    <Product>AI Palm</Product>
    <Description>Discover, use, and share local AI models through the AI Palm community network.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\web\assets\ai-palm-mark.png" LogicalName="AIPalm.BrandMark" />
  </ItemGroup>
</Project>
