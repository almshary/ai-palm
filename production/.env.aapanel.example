POSTGRES_DB=nawah
POSTGRES_USER=nawah
POSTGRES_PASSWORD=REPLACE_WITH_FIRST_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_SECOND_RANDOM_HEX

NAWAH_ENVIRONMENT=production
NAWAH_DATABASE_URL=postgresql+asyncpg://nawah:REPLACE_WITH_FIRST_RANDOM_HEX@postgres:5432/nawah
NAWAH_REDIS_URL=redis://:REPLACE_WITH_SECOND_RANDOM_HEX@redis:6379/0
NAWAH_REGISTRATION_KEY=REPLACE_WITH_THIRD_RANDOM_HEX
NAWAH_ALLOWED_HOSTS=nawah.almshary.site,127.0.0.1,localhost
NAWAH_PUBLIC_BASE_URL=https://nawah.almshary.site
NAWAH_AUTO_CREATE_SCHEMA=false
NAWAH_HOST_TIMEOUT_SECONDS=35
NAWAH_JOB_TIMEOUT_SECONDS=90
NAWAH_PUBLIC_JOBS_PER_MINUTE=12
NAWAH_MAX_RESULT_CHARS=100000
