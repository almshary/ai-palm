# اسم النطاق بدون https://
NAWAH_DOMAIN=nawah.example.com

# استخدم قيماً عشوائية طويلة. الأحرف الست عشرية تمنع مشكلات ترميز رابط قاعدة البيانات.
POSTGRES_DB=nawah
POSTGRES_USER=nawah
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
REDIS_PASSWORD=replace_with_another_64_random_hex_characters

NAWAH_ENVIRONMENT=production
NAWAH_DATABASE_URL=postgresql+asyncpg://nawah:replace_with_64_random_hex_characters@postgres:5432/nawah
NAWAH_REDIS_URL=redis://:replace_with_another_64_random_hex_characters@redis:6379/0

# هذا المفتاح يدخل مرة واحدة في تطبيق Windows للسماح بتسجيل الجهاز في النسخة التجريبية المغلقة.
NAWAH_REGISTRATION_KEY=replace_with_a_third_64_random_hex_characters
NAWAH_ALLOWED_HOSTS=nawah.example.com,api,127.0.0.1,localhost
NAWAH_PUBLIC_BASE_URL=https://nawah.example.com
NAWAH_AUTO_CREATE_SCHEMA=false
NAWAH_HOST_TIMEOUT_SECONDS=35
NAWAH_JOB_TIMEOUT_SECONDS=90
NAWAH_PUBLIC_JOBS_PER_MINUTE=12
NAWAH_MAX_RESULT_CHARS=100000
